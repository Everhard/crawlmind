{
  "name": "crawlmind",
  "version": "0.1.0",
  "description": "AI-native SEO audits from the terminal or any MCP client: broken links, internal link suggestions, page speed by template, crawl diffs.",
  "type": "module",
  "license": "MIT",
  "author": "Andrew Dorokhov <andrew@dorokhov.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Everhard/crawlmind.git",
    "directory": "packages/crawlmind"
  },
  "homepage": "https://github.com/Everhard/crawlmind#readme",
  "bugs": "https://github.com/Everhard/crawlmind/issues",
  "keywords": [
    "mcp",
    "mcp-server",
    "seo",
    "crawler",
    "internal-links",
    "broken-links",
    "page-speed",
    "cli"
  ],
  "bin": {
    "crawlmind": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-readme.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "domhandler": "^5.0.3",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "robots-parser": "^3.0.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
